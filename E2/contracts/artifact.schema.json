{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/devops-a07/artifact.schema.json",
  "title": "A07 Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "type",
    "uri",
    "media_type",
    "producer_job_id"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "ACTUAL_GRAPH",
        "DECLARED_GRAPH",
        "ERROR_REPORT",
        "TRACE_LOG",
        "BUILD_LOG"
      ]
    },
    "uri": {
      "type": "string",
      "pattern": "^artifact://"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "producer_job_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
