{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/devops-a07/finding.schema.json",
  "title": "A07 Dependency Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "type",
    "target",
    "dependency",
    "commit",
    "detector"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["MISSING", "REDUNDANT"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "dependency": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "detector": {
      "enum": ["BUILDCHECKER", "ECHECKER", "INSTRUCTOR_ORACLE"]
    },
    "evidence_uri": {
      "type": "string",
      "pattern": "^artifact://"
    },
    "position": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file", "line"],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "declaration": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "MISSING" } },
        "required": ["type"]
      },
      "then": { "required": ["position"] }
    }
  ]
}
