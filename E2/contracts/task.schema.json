{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops.nju.edu.cn/a07/contracts/task.schema.json",
  "title": "A07 Detection Request and Job Fragment",
  "description": "A07 对 B07 统一 Job 模型中 FULL_CHECK 与 INCREMENTAL_CHECK 的专有约束。创建请求没有 job_id；查询得到的 Job 资源包含 job_id、status、execution、output 与 error。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_type",
    "input"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[a-z0-9-]+$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace-[a-z0-9-]+$"
    },
    "job_type": {
      "enum": [
        "FULL_CHECK",
        "INCREMENTAL_CHECK"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "input": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "queued_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "attempts": { "type": "integer", "minimum": 1 },
        "runner": { "type": "string" }
      }
    },
    "output": { "type": ["object", "null"] },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "description": "A07 在 schema_version 1.0 中当前会产生的错误码；消费者不得把此枚举当作可接收错误码的封闭集合。",
              "enum": ["ENV_3002", "EXEC_4002", "ANALYSIS_5001"]
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": ["object", "null"]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "FULL_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/fullCheckInput"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "INCREMENTAL_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/incrementalCheckInput"
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "project_root"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean_command", "build_command"],
      "properties": {
        "clean_command": {
          "type": "string",
          "minLength": 1
        },
        "build_command": {
          "type": "string",
          "minLength": 1
        },
        "verify_command": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "configuration_id",
        "actual_graph_uri"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "actual_graph_uri": {
          "type": "string",
          "pattern": "^artifact://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "fullCheckInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "environment",
        "build",
        "configuration_id",
        "commit",
        "defined_by",
        "idempotency_key"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "defined_by": {
          "const": "A07"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "incrementalCheckInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "repository",
        "environment",
        "build",
        "configuration_id",
        "baseline",
        "commit",
        "defined_by",
        "idempotency_key"
      ],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "defined_by": {
          "const": "A07"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
