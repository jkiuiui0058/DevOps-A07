{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/devops-a07/task.schema.json",
  "title": "A07 Detection Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_type",
    "input"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "job_type": {
      "enum": [
        "FULL_CHECK",
        "INCREMENTAL_CHECK"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z]+_[0-9]{4}$"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "FULL_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/fullCheckInput"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_type": {
            "const": "INCREMENTAL_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "#/$defs/incrementalCheckInput"
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "project_root"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean_command", "build_command"],
      "properties": {
        "clean_command": {
          "type": "string",
          "minLength": 1
        },
        "build_command": {
          "type": "string",
          "minLength": 1
        },
        "verify_command": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "configuration_id",
        "actual_graph_uri"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "actual_graph_uri": {
          "type": "string",
          "pattern": "^artifact://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "fullCheckInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "environment",
        "build",
        "configuration_id"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "incrementalCheckInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "repository",
        "environment",
        "build",
        "configuration_id",
        "baseline"
      ],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        }
      }
    }
  }
}
